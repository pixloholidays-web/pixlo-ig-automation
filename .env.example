# Copy to .env for local runs. In GitHub, add these as repository secrets instead.
# Claude: local runs use your normal `claude` login, so nothing is needed here.
# GitHub Actions needs CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`) as a repository secret.
CLAUDE_CODE_OAUTH_TOKEN=
UNSPLASH_ACCESS_KEY=                 # unsplash.com/developers -> New Application -> Access Key
PEXELS_API_KEY=                      # pexels.com/api -> fallback photo source
IG_USER_ID=1784xxxxxxxxxxxx          # Instagram Business account ID (run: python cli.py whoami)
IG_ACCESS_TOKEN=EAAG...              # System-user token with instagram_content_publish

# Only for hosting.provider = s3 (AWS S3 or Cloudflare R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=                     # e.g. https://<accountid>.r2.cloudflarestorage.com (leave empty for AWS)
